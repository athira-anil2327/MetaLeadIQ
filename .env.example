# ============================================================
# MetaLeadIQ - Environment Configuration
# Copy this file to `.env` and fill in real values once your
# Meta Developer App is created (see README.md Section 2).
# ============================================================

# --- App / server ---
APP_ENV=development
PORT=8000
DATABASE_PATH=./metaleadiq.db

# --- Meta App (shared across Lead Ads, WhatsApp, Instagram) ---
META_APP_ID=
META_APP_SECRET=
# Any string you choose. Must match what you enter in the Meta
# App Dashboard -> Webhooks -> Verify Token.
META_WEBHOOK_VERIFY_TOKEN=change_me_to_a_random_string

# --- Meta Lead Ads ---
# Page access token for the Facebook Page that owns your lead ad forms.
META_PAGE_ACCESS_TOKEN=

# --- WhatsApp Cloud API ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- Instagram Messaging (via connected Facebook Page) ---
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# --- Graph API version ---
GRAPH_API_VERSION=v21.0
